# ---- App ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:19000

# ---- Database (MySQL via Prisma) ----
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://meetmind:meetmind@localhost:3306/meetmind"
TEST_DATABASE_URL="mysql://meetmind:meetmind@localhost:3306/meetmind_test"

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Storage ----
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# AWS S3 (only required when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Email (Nodemailer SMTP) ----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MeetMind <no-reply@meetmind.ai>"

# ---- Firebase Cloud Messaging ----
# Path to a service account JSON, or paste the JSON inline via FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Google Calendar OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Logging ----
LOG_LEVEL=debug
